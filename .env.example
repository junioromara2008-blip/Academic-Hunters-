# OpenAI API Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# JWT Configuration (Server-side)
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars

# M-Pesa Configuration
MOMO_API_KEY=your_momo_api_key
MOMO_PHONE=077xxxxxxxx
MOMO_MERCHANT_ID=your_merchant_id

# Vercel Deployment (auto-configured)
VERCEL_URL=https://academic-hunters.vercel.app

# File Upload Limits (in bytes)
MAX_FILE_SIZE=15728640

# API Configuration
NODE_ENV=production
ALLOWED_ORIGINS=https://academic-hunters.vercel.app,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
